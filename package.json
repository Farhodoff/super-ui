{
  "name": "@farhod_dev/super-ui",
  "version": "0.0.3",
  "type": "module",
  "author": {
    "name": "Farhod Soyilov",
    "url": "https://github.com/Farhodoff"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Farhodoff/super-ui.git"
  },
  "homepage": "https://super-ui-components.vercel.app",
  "bugs": {
    "url": "https://github.com/Farhodoff/super-ui/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:app",
    "build:app": "vite build",
    "build:css": "tailwindcss -i ./src/index.css -o ./dist/styles.css --minify",
    "build:lib": "tsup && npm run build:css",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "npm run build-storybook && vercel deploy storybook-static --project super-ui-storybook --prod --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "tsx scripts/generate-api-docs.ts",
    "sync:cli": "node scripts/sync-cli-templates.cjs",
    "release": "changeset publish"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "tailwind.preset.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.preset": "./tailwind.preset.js",
    "./tailwind.preset.js": "./tailwind.preset.js"
  },
  "dependencies": {
